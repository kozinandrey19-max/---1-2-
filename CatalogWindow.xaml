<Window x:Class="DolgoStrou.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DolgoStrou"
        mc:Ignorable="d"
        Title="Чудо Обувь — Каталог" 
        Height="700" Width="1200"
        FontFamily="Calibri"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Логотип + ФИО + Выход -->
        <Grid Background="#D2F6E7" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="👟" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Чудо Обувь" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>

            <TextBlock x:Name="FioText" 
                       Text="ФИО" 
                       FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,120,0"
                       Grid.Column="1"
                       Foreground="#333333"/>

            <Button Content="Выход" 
                    Click="Logout_Click" 
                    Background="#70B2AF" 
                    Foreground="White"
                    BorderThickness="0"
                    Height="35" Width="90"
                    FontSize="14" FontWeight="Bold"
                    Grid.Column="2"
                    Margin="10"/>
        </Grid>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="15"
                      Background="#FFFFFF">
            <ItemsControl x:Name="ProductsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка товара. Background биндится из ViewModel -->
                        <Border Width="400" Height="280" Margin="8" 
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                Background="{Binding CardBackground}"
                                Padding="12"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. ИЗОБРАЖЕНИЕ -->
                                <Border Grid.Column="0" 
                                        BorderBrush="#DDDDDD" 
                                        BorderThickness="1" 
                                        Background="#FFFFFF"
                                        Margin="0,0,12,0"
                                        CornerRadius="3">
                                    <Image Source="{Binding ImagePath, Mode=OneWay}" 
                                           Stretch="Uniform"
                                           Margin="5"/>
                                </Border>

                                <!-- 2. ИНФОРМАЦИЯ О ТОВАРЕ -->
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Category, Mode=OneWay}" 
                                               FontWeight="Bold" FontSize="12" Foreground="#555555"/>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" 
                                               FontWeight="Bold" FontSize="15" 
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,6" Foreground="#111111"/>

                                    <TextBlock FontSize="12" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">Производство:</Run>
                                        <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" MaxHeight="60">
                                        <Run FontWeight="SemiBold">Состав:</Run>
                                        <Run Text="{Binding Composition, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Цена со скидкой -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock FontWeight="Bold">Цена:</TextBlock>
                                        <TextBlock Text="{Binding OldPrice, Mode=OneWay}" 
                                                   Foreground="Red" 
                                                   TextDecorations="Strikethrough"
                                                   Margin="5,0,0,0"
                                                   Visibility="{Binding OldPriceVisibility, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding NewPrice, Mode=OneWay}" 
                                                   Foreground="#111111"
                                                   FontWeight="Bold"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Количество и индикатор много/мало -->
                                    <TextBlock FontSize="13">
                                        <Run FontWeight="Bold">В наличии:</Run>
                                        <Run Text="{Binding TotalQuantity, Mode=OneWay}"/>
                                        <Run Text=" пар (" FontWeight="SemiBold" Foreground="#555555"/>
                                        <Run Text="{Binding QuantityLabel, Mode=OneWay}" FontWeight="Bold" Foreground="#333333"/>
                                        <Run Text=")" FontWeight="SemiBold" Foreground="#555555"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 3. БЕЙДЖ СКИДКИ 25% -->
                                <Border Grid.Column="2" 
                                        BorderBrush="#DDDDDD" 
                                        BorderThickness="1"
                                        Background="#FFFFFF"
                                        VerticalAlignment="Top"
                                        Height="70"
                                        CornerRadius="3"
                                        Visibility="{Binding DiscountBadgeVisibility, Mode=OneWay}">
                                    <StackPanel HorizontalAlignment="Center" 
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Скидка" 
                                                   TextAlignment="Center"
                                                   FontSize="11" 
                                                   FontWeight="Bold"
                                                   Foreground="#D32F2F"/>
                                        <TextBlock Text="25%" 
                                                   TextAlignment="Center"
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Foreground="#D32F2F"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
